{
  "name": "cleanify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev-cert.pem",
    "dev:mac": "node scripts/dev-http-proxy.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:users": "node --env-file=.env.local scripts/seed-users.mjs",
    "db:push": "node --env-file=.env.local scripts/migrate.mjs",
    "db:status": "node --env-file=.env.local scripts/migrate.mjs --status"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "maplibre-gl": "^6.9.1",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
