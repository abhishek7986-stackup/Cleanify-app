# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship it to every
# phone running the PWA.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web Push (generate once: npx web-push generate-vapid-keys)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@cleanify.example

# ---------------------------------------------------------------------------
# Travel time. Set a HARD quota cap in Google Cloud Console on day one — a
# recompute loop is the realistic way this bill runs away.
# ---------------------------------------------------------------------------
TRAVEL_PROVIDER=google_routes
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Business (Meta Cloud API). Submit message templates for approval in
# week one — approval takes days and blocks both OTP login and late alerts.
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
